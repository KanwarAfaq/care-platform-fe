# Frontend (browser-safe values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: comma-separated emails allowed to open /admin (otherwise any signed-in Supabase user)
VITE_ADMIN_EMAILS=
# Optional: canonical site URL used for canonical links and sitemap (Vercel's production domain is used if empty)
VITE_SITE_URL=

# Backend / LINE bot (server-side only, set in Vercel project settings, never in the frontend)
SUPABASE_URL=
SUPABASE_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
